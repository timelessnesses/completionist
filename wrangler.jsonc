/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "completionist",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-25",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_als"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"FCM_PROJECT_ID": "completionist-6a4af"
	},
	"d1_databases": [
		{
			"binding": "COMPLETIONIST_DB",
			"database_name": "completionist-db",
			"database_id": "9b6df646-5fa3-4ee4-a613-3649bf4826a2",
			"migrations_dir": "drizzle",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "COMPLETIONIST_KV",
			"id": "3b44dbe7a453453da6b89cce18596dae"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "GlobalWS",
				"class_name": "GlobalWS"
				// "script_name": "GlobalWS"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["GlobalWS"]
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "completionist-queue",
				"max_batch_size": 10,
				"max_retries": 5
			},
			{
				"queue": "websocket-queue",
				"max_batch_size": 10,
				"max_retries": 5
			},
			{
				"queue": "webpush-queue",
				"max_batch_size": 10,
				"max_retries": 5
			},
			{
				"queue": "email-queue",
				"max_batch_size": 10,
				"max_retries": 5
			},
			{
				"queue": "gcm-queue",
				"max_batch_size": 10,
				"max_retries": 5
			}
		],
		"producers": [
			{
				"queue": "completionist-queue",
				"binding": "COMPLETIONIST_QUEUE"
			},
			{
				"queue": "websocket-queue",
				"binding": "WS_QUEUE"
			},
			{
				"queue": "webpush-queue",
				"binding": "WEBPUSH_QUEUE"
			},
			{
				"queue": "email-queue",
				"binding": "EMAIL_QUEUE"
			},
			{
				"queue": "gcm-queue",
				"binding": "GCM_QUEUE"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "COMPLETIONIST_R2",
			"bucket_name": "completionist-storage"
		}
	]

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}