{
	"name": "completionist",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo '' && npm run smui-theme-light && npm run smui-theme-dark",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"secret-generator": "openssl rand -base64 32",
		"smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
		"smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark",
		"dev:worker": "concurrently -k -n build,wrangler -c blue,green \"vite build --watch\" \"wrangler dev\""
	},
	"devDependencies": {
		"@material/animation": "^14.0.0",
		"@material/button": "^14.0.0",
		"@material/card": "^14.0.0",
		"@material/chips": "^14.0.0",
		"@material/circular-progress": "^14.0.0",
		"@material/dom": "^14.0.0",
		"@material/elevation": "^14.0.0",
		"@material/feature-targeting": "^14.0.0",
		"@material/icon-button": "^14.0.0",
		"@material/list": "^14.0.0",
		"@material/ripple": "^14.0.0",
		"@material/rtl": "^14.0.0",
		"@material/shape": "^14.0.0",
		"@material/theme": "^14.0.0",
		"@material/top-app-bar": "^14.0.0",
		"@material/touch-target": "^14.0.0",
		"@material/typography": "^14.0.0",
		"@mdi/js": "^7.4.47",
		"@smui/button": "^9.0.2",
		"@smui/card": "^9.0.2",
		"@smui/chips": "^9.0.3",
		"@smui/circular-progress": "^9.0.2",
		"@smui/icon-button": "^9.0.2",
		"@smui/list": "^9.0.2",
		"@smui/menu": "^9.0.2",
		"@smui/menu-surface": "^9.0.2",
		"@smui/paper": "^9.0.2",
		"@smui/ripple": "^9.0.2",
		"@smui/tooltip": "^9.0.2",
		"@smui/top-app-bar": "^9.0.2",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22.20.1",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"smui-theme": "^9.0.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"sveltekit-cloudflare-do": "^0.2.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.114.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1116.0",
		"@aws-sdk/s3-request-presigner": "^3.1116.0",
		"@capacitor/core": "^8.5.0",
		"@capacitor/local-notifications": "^8.3.0",
		"@capacitor/push-notifications": "^8.1.2",
		"@capacitor/splash-screen": "^8.0.2",
		"@capawesome-team/capacitor-android-battery-optimization": "^8.0.1",
		"@capawesome/capacitor-google-sign-in": "^0.1.2",
		"@joshthomas/sveltekit-adapter-cloudflare": "^0.2.1",
		"@squareetlabs/capacitor-dont-kill-my-app": "^7.0.0",
		"concurrently": "^10.0.5",
		"fcm-cloudflare-workers": "^2.0.1",
		"google-auth-library": "^11.0.2",
		"jose": "^6.2.7",
		"resend": "^6.18.1",
		"set-cookie-parser": "^3.1.2",
		"web-push": "^3.6.7",
		"xlsx": "^0.18.5"
	}
}
